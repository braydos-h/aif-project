[Unit]
Description=Cow Weight Estimator (two-user invite-only service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aif
Group=aif
# Direct LAN/public bind (open mode): reachable on all interfaces on port
# 8080. For proxy-only production, change back to 127.0.0.1 and front with
# Caddy.
WorkingDirectory=/opt/aif
EnvironmentFile=/etc/aif/aif.env
ExecStart=/opt/aif/aif-backend --host 0.0.0.0 --port 8080
# The database, backups staging, and .env-adjacent state live here.
ReadWritePaths=/var/lib/aif
# Graceful shutdown: SIGTERM, 20 s to drain in-flight estimates.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=300
# Resource limits for a small two-user box.
MemoryMax=512M
CPUQuota=100%
TasksMax=128
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSNI=true
# Logs go to the journal; rotate with deploy/logrotate-aif if file logs used.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
