# Cow Weight Estimator configuration
# This file is loaded automatically at startup (standard-library loader, no
# external dependencies). Values already set in the environment take
# precedence over what is defined here.

# Which backend to use for estimation:
#   ollama  - local Ollama runtime (default)
#   custom  - generic AI API (requires AIF_AI_API_URL below)
#   none    - deterministic local fallback (no network calls)
AIF_AI_BACKEND=ollama

# Ollama settings (used when AIF_AI_BACKEND=ollama)
AIF_OLLAMA_URL=http://localhost:11434/api/generate
AIF_AI_MODEL=llava

# Generic / custom AI API (used when AIF_AI_BACKEND=custom, or when
# AIF_AI_API_URL is set). The service POSTs {"image", "prompt"} and expects a
# JSON response containing weight_kg / estimate_kg / estimated_weight_kg.
# AIF_AI_API_URL=
# AIF_AI_API_KEY=