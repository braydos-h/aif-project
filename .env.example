# Cow Weight Estimator configuration
# Copy this file to .env and fill in your values. Do not commit a real key.
# Full reference: docs/security.md. Production checklist: docs/deployment.md.

# Which backend to use for estimation:
#   ollama  - Ollama Cloud (default)
#   none    - deterministic local fallback (no network calls)
AIF_AI_BACKEND=ollama

# Ollama Cloud settings (used when AIF_AI_BACKEND=ollama). Create an API key at
# https://ollama.com/settings/keys and set it below. Do not commit a real key.
AIF_OLLAMA_URL=https://ollama.com/api/generate
AIF_AI_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=

# In-memory result cache. Seconds a cached estimate stays valid. 0 disables.
# Default: 300 (5 min). Repeated requests for the same image return instantly.
AIF_CACHE_TTL=300

# --- Two-user invite-only service (see docs/security.md) ---
# Local default is open (anonymous estimates, like before). Set to 1 to
# require login for estimation, history, animals, exports, and metrics.
AIF_REQUIRE_AUTH=0
# Production hardening: implies AIF_REQUIRE_AUTH=1, secure cookies, HSTS,
# same-origin CORS, private metrics, reduced info/health, and rejection of
# per-request provider overrides. Startup aborts unless AIF_PUBLIC_ORIGIN
# is https:// and (with backend=ollama) OLLAMA_API_KEY is set.
AIF_PRODUCTION=0
# Directory holding aif.db (SQLite). Created on startup.
AIF_DATA_DIR=data
# Public HTTPS origin used to build invite/recovery links (never Host header).
AIF_PUBLIC_ORIGIN=http://127.0.0.1:8080
# Bootstrap: when the database is empty, mint an operator invite for this
# email at startup and print the one-time link for private relay.
AIF_OPERATOR_EMAIL=

# --- Sessions, invites, limits ---
# Secure cookie flag (defaults to AIF_PRODUCTION). Session/invite lifetimes.
AIF_COOKIE_SECURE=
AIF_SESSION_DAYS=30
AIF_INVITE_DAYS=7
# Photo estimates per user per UTC day (tape-only estimates are free).
AIF_DAILY_LIMIT=200
# Concurrent provider inferences process-wide; start paused.
AIF_MAX_INFERENCE=4
AIF_INFERENCE_PAUSED=0
# Peers allowed to supply X-Forwarded-For (the local reverse proxy).
AIF_TRUSTED_PROXIES=127.0.0.1,::1

# --- Backups (deploy/backup.sh reads this from the environment, never a file) ---
# AIF_BACKUP_PASSPHRASE=
